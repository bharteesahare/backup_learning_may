sudo -u postgres psql


Set password for postgres user
sudo -u postgres psql
\dt
# create the db
CREATE DATABASE "my-app-typeorm-db";

# Then connect to it:
\c "my-app-typeorm-db"

# If you want to double-check it was created:
\l

ALTER USER postgres PASSWORD 'postgres';

nest g resource user



