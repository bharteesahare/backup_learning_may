Predefined method of array

class UsersController < ApplicationController
  def index
    page = params[:page] || 1
    per_page = params[:per_page] || 10
    offset = (page - 1) * per_page
    users = User.offset(offset).limit(per_page)
    render json: {
      users: users,
      pagination: {
        page: page,
        per_page: per_page,
        total_pages: (User.count / per_page.to_f).ceil,
        total_records: User.count
      }
    }
  end
end