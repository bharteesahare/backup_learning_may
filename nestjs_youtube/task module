## 🧾 DTO Example (Create Task)

```ts
export class CreateTaskDto {
  @IsString()
  @IsNotEmpty()
  title: string;

  @IsEnum(TaskStatus)
  status: TaskStatus;

  @IsString()
  userId: string;

  @IsString()
  projectId: string;
}
```

