def rob(nums)
    return 0 if nums.empty?
    return nums[0] if nums.length == 1
    def linear_array(houses)
        prev1, prev2 = 0,0
        houses.each do |money|
            new_rob = [prev1, prev2 + money].max
            prev2, prev1 = prev1, new_rob
        end
        prev1
    end

    #case 1 ignore last element
    case1 = linear_array(nums[0...-1])
    case2 = linear_array(nums[1..])
    return [case1, case2].max
end

